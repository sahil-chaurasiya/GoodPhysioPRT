# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
# Local:   mongodb://127.0.0.1:27017/prt_health_app
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/prt_health_app
MONGO_URI=mongodb://127.0.0.1:27017/prt_health_app

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Cloudinary (create a free account at https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Default admin seeded on first boot if no admin exists
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@cipla.com
SEED_ADMIN_PASSWORD=Admin@123
